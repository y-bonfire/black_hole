{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run Step02",
            "type": "shell",
            "command": "cmake --build build --config Debug --target Step02; if ($LASTEXITCODE -eq 0) { & './build/Debug/Step02.exe' }",
